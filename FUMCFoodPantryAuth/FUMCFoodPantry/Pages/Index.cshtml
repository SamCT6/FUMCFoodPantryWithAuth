@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}


<div class="container-fluid px-0"style="background:
        linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
            url('/images/location.jpg');
        background-size: cover; 
        height:500px; 
        padding-top:80px;
        width: 100%">

    <div class="text-center">
        <img src="~/images/FUMCLogo.png" alt="FUMC Logo" height="400"/>
    </div>
</div>


<div class="text-center">
    <img src="~/images/FoodPantryLogo.jpg" alt="Food Pantry Logo" height="250" />
</div>


<div class="container">
    <h2>Who We Are</h2>
    <p>
        In keeping with our calling to serve God and our neighbors, the Feeding Ministries of the First United Methodist Church of Conway, Arkansas, strive to provide food to those persons who are in need.

   
    </p>
<!--Cards-->
        
            <div class="row gx-4 gx-lg-5">
                <div class="col-md-6 mb-5">
                    <div class="card h-100" style="color: white; min-height: 350px;">
                        <div class="card-body d-flex flex-column justify-content-center text-center" style="background:
                        linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
                        url('/images/cars.png')">
                            <h2 class="card-title text-center">Check In</h2>
                            <p class="card-text pb-3">Picking up food at our drive-thru? Check in here to make the process go faster.</p>
                            <a class="btn btn-primary btn-md" asp-page="/CheckIn">Check In</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-5">
                    <div class="card h-100" style="color: white; min-height: 350px;">
                        <div class="card-body d-flex flex-column justify-content-center text-center" style="background:
                        linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
                        url('/images/food.jpg')">
                            <h2 class="card-title text-center">What We've Got</h2>
                            <p class="card-text pb-3">Curious about your options? Click here to see what we have in stock.</p>
                            <a class="btn btn-primary btn-md" asp-page="/PublicInventory/Index">See What We Have</a>
                        </div>
                    </div>
                </div>
            </div>

<!--Location-->
<div class="row gx-4 gx-lg-5 align-items-center my-5">
                <div class="col-lg-7"><img class="img-fluid rounded mb-4 mb-lg-0" src="~/images/location.jpg" alt="FUMC building" /></div>
                <div class="col-lg-5">
                    <h1 class="font-weight-light">Location</h1>
                    <p>We are located at 1610 Prince St in Conway, AR.</p>
                </div>
            </div>
</div>

    <div class="w-100 my-4">
    <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1228.494609144074!2d-92.44678331143074!3d35.09256244215034!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87d2821a150cf5d9%3A0x8371e5bc10383e7b!2s1610%20Prince%20St%2C%20Conway%2C%20AR%2072034!5e0!3m2!1sen!2sus!4v1778175907561!5m2!1sen!2sus" 
        width="100%"
        height="400"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
    </iframe>
</div>

<section class="w-100 my-5 px-5" style="background-color:#EBEBEB;">
<div class="py-4">
    <h3>Hours of Operation</h3>
    <p>
        Our food pantry is open every week beginning at 4:30pm.
        <ul>
            <li>
                The 1st, 3rd & 5th Thursdays of each month our food pantry distributes all food drive through style (4:30-5:30pm).
            </li>
            <li>
                The 2nd and 4th Thursdays of the month is our Amazing Grace Cafe. Guests are invited into the Fellowship Hall to pick their own food items and share a meal together (4:30-5:30p). Drive through is not available this week.
            </li>
            <li>
                Our food pantry is open for individuals and households to receive food every week as needed. Registration and photo identification are required.
            </li>
        </ul>

    </p>
    <h4>Find out more <a href="https://conwayfumc.org/">here</a></h4>
    </div>
</section>




