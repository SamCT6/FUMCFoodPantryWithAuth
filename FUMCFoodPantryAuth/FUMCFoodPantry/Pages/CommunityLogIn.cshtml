@page
@using RazorPagesMovie.Pages
@model CommunityLogInModel
@{
    ViewData["Title"] = "Community Log-In";
}

<head>
    <title>Community Log-In</title>
</head>


<body>

<div class="container-fluid pt-5 text-center">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-4 mx-auto text-center p-3">
            <form method="post">
                <div class="mb-3">
                    <input asp-for="UserID" class="form-control" placeholder="Food Pantry ID #" />
                    <span asp-validation-for="UserID" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <input type="submit" value="Log-In" class="btn btn-primary">
                </div>
            </form>
            <a asp-page="/Application/UserApplication">Aren't registered with us? Click here to apply</a>
            <a asp-page="/SpanishApplication/SpanishUserApplication">¿Aún no está registrado con nosotros? Haga clic aquí para solicitarlo.</a>
        </div>
    </div>
</div>
</body>