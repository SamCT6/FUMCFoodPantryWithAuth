@page
@using RazorPagesMovie.Pages
@model FUMCFoodPantry.Pages.SubmittedOrders.CreateModel
@{
    ViewData["Title"] = "Drive-Thru Check In";
}


<head>
    <title>Drive-Thru Check In</title>
</head>



<body>

<div class="container-fluid pt-5 text-center">
    <h2>@ViewData["Title"]</h2>
</div>
<form method="post">
    <div class="col text-center p-3">
        <h4>Today's Options</h4>
        <div class="row gx-4 gx-lg-5 mt-3">
            <div class="col-md-6 mb-5">
                <div class="card h-100">
                    <div class="card-body mb-4">
                        <h5 class="card-title text-center">Box 1</h5>
                        <p class="card-text">
                                @foreach(var item in Model.MainBoxItems)
                                {
                                    <span>@item.ItemName</span><br />
                                }
                            </p>
                        <div class="card-footer text-center">
                            <p>Select Amount:</p>
                            <div class="form-group">
                                <label asp-for="OrderForm.Box1" class="control-label"></label>
                                <input asp-for="OrderForm.Box1" class="form-control" />
                                <span asp-validation-for="OrderForm.Box1" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-5">
                <div class="card h-100">
                    <div class="card-body mb-4">
                        <h5 class="card-title text-center">Box 2</h5>
                        <p class="card-text">
                                @foreach(var item in Model.AltBoxItems)
                                {
                                    <span>@item.ItemName</span><br />
                                }
                            </p>
                        <div class="card-footer text-center">
                            <p>Select Amount:</p>
                            <div class="form-group">
                                <label asp-for="OrderForm.Box2" class="control-label"></label>
                                <input asp-for="OrderForm.Box2" class="form-control" />
                                <span asp-validation-for="OrderForm.Box2" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary btn-md">Confirm Choices</button>
</form>


<script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>
</body>

            
            

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
