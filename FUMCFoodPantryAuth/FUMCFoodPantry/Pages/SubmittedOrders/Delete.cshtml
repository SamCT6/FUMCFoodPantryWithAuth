@page
@model FUMCFoodPantry.Pages.SubmittedOrders.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<div class="container px-2">
<h1>Complete Order</h1>

<h3>Are you sure you want to complete this order? It will be deleted.</h3>
<div>
    <h4>OrderForm</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrderForm.Box1)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrderForm.Box1)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrderForm.Box2)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrderForm.Box2)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="OrderForm.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
</div>
