@page
@model FUMCFoodPantry.Pages.SubmittedOrders.IndexModel

@{
    ViewData["Title"] = "Orders";
}


<div class="container mt-4">

<h1 class="mb-3">Orders</h1>

<a asp-page="Create" class="btn btn-success mb-3">Make a New Order</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <td>
                @Html.DisplayNameFor(model => model.OrderForm[0].Name)
            </td>
             <td>
                @Html.DisplayNameFor(model => model.OrderForm[0].Id)
            </td>
            <td>
                @Html.DisplayNameFor(model => model.OrderForm[0].Box1)
            </td>
            <td>
                @Html.DisplayNameFor(model => model.OrderForm[0].Box2)
            </td>
            <td></td>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.OrderForm) {
        <tr>
            <th>
                @Html.DisplayFor(modelItem => item.Name)
            </th>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Box1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Box2)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Order Completed</a>
            </td>
        </tr>
}
    </tbody>
</table>
<a class="btn btn-primary mt-3" asp-controller="/AdminHome">Back</a>

</div>