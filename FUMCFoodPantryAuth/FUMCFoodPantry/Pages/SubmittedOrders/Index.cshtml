@page
@model FUMCFoodPantry.Pages.SubmittedOrders.IndexModel

@{
    ViewData["Title"] = "Index";
}

<div class="container px-2">
<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
             <th>
                @Html.DisplayNameFor(model => model.OrderForm[0].Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderForm[0].Box1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderForm[0].Box2)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.OrderForm) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Box1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Box2)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Order Completed</a>
            </td>
        </tr>
}
    </tbody>
</table></div>
