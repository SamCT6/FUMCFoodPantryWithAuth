@page "{id:int}"
@using FUMCFoodPantry.Pages
@model MemberIdModel
@{
    ViewData["Title"] = "Application Submitted";
}

<div class="container-fluid pt-5 text-center">
    <h2>@ViewData["Title"]</h2>
</div>

<div class="col text-center p-3">
    <p>Thank you for submitting an application.</p>
    <h4>Your Member ID Is:</h4>
    <h1 class="text-primary">#@Model.DisplayMemberId</h1> 
</div>

<div>
    <a asp-page="Index">Back to Home</a>
</div>